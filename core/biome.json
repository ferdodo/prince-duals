{
    "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
    "linter": {
        "rules": {
            "complexity": {
                "useArrowFunction": "off"
            }
        }
    },
    "formatter": {
        "enabled": false
    },
    "assist": {
        "actions": {
            "source": {
                "organizeImports": {
                    "level": "off"
                }
            }
        }
    }
}